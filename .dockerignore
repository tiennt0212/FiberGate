# Keep the fibergate-core build context (repo root, see docker/fibergate-core/Dockerfile) small
# and avoid leaking local secrets/dev artifacts into the image.

# VCS
.git/
.gitignore

# Dependencies (reinstalled inside the image from pnpm-lock.yaml)
**/node_modules/
.pnpm-store/

# Build outputs (rebuilt inside the image)
**/.next/
**/dist/
**/out/
**/build/
**/*.tsbuildinfo

# Env files — never bake secrets into the image, except root .env and
# apps/web/.env.local: `next build` imports lib/db/lib/fiber at module load
# time, which need real POSTGRES_*/FIBER_NODE_URL values to not throw during
# build (no real DB/Fiber connection happens at build time). Both excluded
# again from the final runner stage in the Dockerfile, so neither ships in
# the image — only sits in the local build cache.
**/.env
**/.env.local
**/.env*.local
**/.env.production
!/.env
!/apps/web/.env.local

# Fiber node runtime data / keys — irrelevant to the fibergate-core build.
# fiber-node-payer's runtime dir can end up root-owned once that container
# has run locally (its `fiber` subdir is written by the container's own
# process), which makes the build context tar fail with a permission error
# if this pattern is missing — always exclude both, not just fiber-node/.
docker/fiber-node/
docker/fiber-node-payer/

# Docs — pure markdown, never read by the Dockerfile/build
.context/
README.md

# Harness / editor / misc
.claude/
.DS_Store
*.log
.turbo/
