# Copy this file to apps/web/.env.local and fill in real values.
# Never commit apps/web/.env.local — it is already covered by the root .gitignore (.env*).
# Full description of each var: .context/architecture/system-design.md#environment-variables

DATABASE_URL=                    # postgres://user:pass@postgres:5432/fibergate
ADMIN_PASSWORD_HASH=             # bcrypt hash, used for dashboard single-admin login
FIBERGATE_INTERNAL_SECRET=       # shared secret, storefront app uses this to call /api/v1/*

FIBER_NODE_URL=                  # http://fiber-node:8227 (docker internal network)
FIBER_NODE_SECRET=               # Biscuit token, optional — not required since fiber-node
                                  # only binds internally on the docker network, no public IP.
                                  # If enabled, token needs permission for the methods in use,
                                  # plus read("cch") if calling subscribe_store_changes (Phase 2).

WEBHOOK_SIGNING_KEY=             # per-endpoint, random secret used to sign webhook payloads
CRON_SECRET=                     # optional, protects /api/cron/poll-invoices (manual trigger)
