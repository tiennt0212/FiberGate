# Copy to apps/web/.env.local. `pnpm dev` loads this via dotenv-cli, layered on
# top of the root .env (see ../../.env.example) — .env.local here only needs to
# override the handful of values that genuinely differ for local dev outside
# Docker. Everything else (POSTGRES_USER/PASSWORD/DB, ADMIN_PASSWORD_HASH,
# FIBERGATE_INTERNAL_SECRET, FIBER_NODE_RPC_AUTH_TOKEN, WEBHOOK_SIGNING_KEY,
# CRON_SECRET) comes from the root .env — don't duplicate them here.

# [CONFIGURABLE] Default suits most local setups (a Postgres running on your own
# machine) — change only if your local Postgres listens elsewhere. NOT "postgres":
# that hostname only resolves inside the docker-compose internal network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# [FIXED VALUE] Root .env's FIBER_NODE_URL points at the docker-only DNS name
# "fiber-node", which won't resolve here. docker-compose.yml publishes
# fiber-node's RPC loopback-only (127.0.0.1:8227), so this default works as
# long as fiber-node is running via `docker compose up -d fiber-node`.
FIBER_NODE_URL=http://localhost:8227
