{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e .env.local -e ../../.env -- next dev",
    "build": "dotenv -e .env.local -e ../../.env -- next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -e ../../.env -- drizzle-kit migrate",
    "test:unit": "vitest run",
    "test:integration": "cd ../../bruno && bru run --env local",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ckb-ccc/fiber": "0.0.0-canary-20260505020844",
    "antd": "^5.29.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "^14.2.35",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.7",
    "@usebruno/cli": "^3.5.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
