# Copy to apps/demo-storefront/.env.local — plain Next.js .env.local loading
# for `pnpm --filter demo-storefront dev`, no dotenv-cli/root-.env layering
# like apps/web uses. This SAME file is also read by
# apps/demo-storefront/docker-compose.demo.yml (via env_file) when deploying
# through Docker Compose — create it either way, it's the one place this
# app's config lives. This app is a standalone consumer of @fibergate/sdk,
# same as any third-party merchant app — it deliberately does not read
# apps/web's env vars or the root .env directly, only what's below, copied
# by hand.
#
# (fiber-node-payer, the second local Fiber node for paying demo invoices,
# now lives in the root docker-compose.yml/.env instead — not this file.)

# [REQUIRED] Root URL (no /api/v1 suffix) of the FiberGate deployment this
# storefront integrates with. http://localhost:3000 for local dev
# (fibergate-core running via `pnpm dev` or `pnpm docker:dev`). Ignore this
# value if deploying via `docker compose -f docker-compose.yml -f
# apps/demo-storefront/docker-compose.demo.yml up -d` — that overlay hardcodes
# http://fibergate-core:3000 (docker DNS name) regardless of what's here.
FIBERGATE_BASE_URL=http://localhost:3000

# [REQUIRED] Must match fibergate-core's FIBERGATE_INTERNAL_SECRET exactly —
# this app calls POST/GET /api/v1/invoices with it as a Bearer token.
FIBERGATE_INTERNAL_SECRET=

# [REQUIRED] Must match the secret you set when registering this app's
# webhook endpoint on the FiberGate deployment above (url:
# http://localhost:3001/api/webhook for local dev — event: payment.paid) —
# used to verify the X-Fiber-Signature header on inbound POST /api/webhook
# requests. There is no dashboard UI for managing webhook endpoints yet
# (webhook_endpoints has a service layer, apps/web/lib/services/webhooks.ts,
# but no route/UI calling it) — register it however you're currently doing
# that (direct DB write, a script, etc.) and paste the secret here.
DEMO_WEBHOOK_SECRET=
