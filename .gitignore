# env files — KHÔNG commit secrets
.env
.env.local
.env*.local
.env.production

# bruno/.env — real FIBERGATE_INTERNAL_SECRET value read via
# {{process.env.FIBERGATE_INTERNAL_SECRET}} in bruno/environments/local.bru.
# bruno/.env.example (template, placeholder only) IS committed.
bruno/.env

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
out/
build/
*.tsbuildinfo

# Supabase local
supabase/.branches/
supabase/.temp/

# Misc
.DS_Store
*.log
.turbo/
.claude/harness/

# fiber-node runtime data — bind-mounted to /fiber in docker-compose.yml.
# Includes the merchant's CKB testnet private key (ckb/key) and the node's
# generated store/identity files. Only the pre-seeded config.yml is committed.
docker/fiber-node/*
!docker/fiber-node/config.yml

# Same pattern for fiber-node-payer's runtime data (local-testing-only, see
# docker-compose.yml's fiber-node-payer service) — includes its own separate
# CKB testnet key (ckb/key), never fiber-node's.
docker/fiber-node-payer/*
!docker/fiber-node-payer/config.yml
