meta {
  name: Create invoice - success (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/invoices
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{fibergateInternalSecret}}
}

body:json {
  {
    "amount": 1.5,
    "asset": "CKB",
    "description": "Bruno integration test invoice"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("createdInvoiceId", res.body.data.id);
    bru.setVar("createdInvoicePaymentHash", res.body.data.payment_hash);
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("error is null", function () {
    expect(res.body.error).to.equal(null);
  });

  test("data has expected invoice shape", function () {
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("payment_hash");
    expect(res.body.data.asset).to.equal("CKB");
    expect(res.body.data.amount).to.equal(1.5);
    expect(res.body.data.status).to.equal("pending");
  });
}
