meta {
  name: Create invoice - invalid amount (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/invoices
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{fibergateInternalSecret}}
}

body:json {
  {
    "amount": 0,
    "asset": "CKB"
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("error code is INVALID_AMOUNT", function () {
    expect(res.body.data).to.equal(null);
    expect(res.body.error.code).to.equal("INVALID_AMOUNT");
  });
}
