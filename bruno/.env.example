# Copy to bruno/.env — never commit bruno/.env (real secret value).
# Read by environments/local.bru via {{process.env.FIBERGATE_INTERNAL_SECRET}}
# interpolation, mirroring the same FIBERGATE_INTERNAL_SECRET value set in the
# root .env used by `docker compose up -d` (see ../.env.example). Must NOT be
# marked as a Bruno-native "secret" var in environments/local.bru — that
# marking is inaccessible from `bru run` (CLI), only usable in the GUI.
FIBERGATE_INTERNAL_SECRET=
