# .env for `docker compose -f docker-compose.release.yml up -d` — the
# published-image merchant deploy path (issues #21 + #41). Copy to .env
# alongside docker-compose.release.yml and fill in real values — never
# commit .env. Same required values as root .env.example (see that file's
# comments and README.md "Generating secrets" for how to generate each one),
# minus FIBER_PAYER_SECRET_KEY_PASSWORD (fiber-node-payer is dev/local-testing
# only, not part of this release bundle), plus 2 new vars below for the
# published image itself.

# ---- postgres container init ----
POSTGRES_USER=fibergate
POSTGRES_DB=fibergate
# [REQUIRED]
POSTGRES_PASSWORD=

# ---- fiber-node's own secret ----
# [REQUIRED] Password protecting the CKB testnet key file at
# docker/fiber-node/ckb/key. See README.md "Running the full stack" step 2.
FIBER_SECRET_KEY_PASSWORD=

# ---- nginx + certbot (public HTTPS entry point) — see
# docs/merchants/public-https-deploy.md ----
# [REQUIRED] Public domain for this deploy, DNS pointed at this host,
# ports 80/443/8228 reachable from the internet. It is also the single source
# for the address fiber-node announces to the Fiber network (the compose file
# builds both the plain-TCP and /wss multiaddrs from it) — leave it blank and
# the network bans this node, so no payment can ever reach it.
DOMAIN=

# [OPTIONAL] A second, NON-proxied DNS name for this same host, used only for
# fiber-node's P2P/WSS address. Blank is correct unless DOMAIN above sits behind
# a CDN proxy (e.g. Cloudflare's orange cloud): a proxied record forwards only
# HTTP/HTTPS ports, so port 8228 is dropped at the CDN edge and your node
# announces a name nobody can dial — it looks correctly announced, reports
# itself healthy, and simply never gets paid. If that's your setup, point this
# at a DNS-only ("grey cloud") record for the same machine, e.g.
# fiber.example.com; certbot-init adds it to your certificate automatically so
# the /wss address keeps validating. create-fibergate asks about this and fills
# it in for you.
FIBER_P2P_DOMAIN=
# [OPTIONAL] Email for Let's Encrypt certificate expiry notices. Not read by
# `docker compose up -d` at all (nginx-certs-preflight generates a temporary
# self-signed cert regardless of this value) — only needed for the one-time
# `docker compose run --rm certbot-init` in
# docs/merchants/public-https-deploy.md step 3, when you're ready to get a
# real trusted cert. Safe to leave blank until then.
CERTBOT_EMAIL=

# ---- FiberGate app vars (fibergate-core) ----
# [REQUIRED] Base64-encoded bcrypt hash — seeds the initial dashboard admin
# password only; change it later from Dashboard -> Settings (issue #30).
# See README.md "Generating secrets" for why base64, not the raw hash.
ADMIN_PASSWORD_HASH_B64=
# [REQUIRED] Signs the dashboard session cookie.
DASHBOARD_SESSION_SECRET=
# [REQUIRED] Shared secret — the storefront app uses this to call /api/v1/*
FIBERGATE_INTERNAL_SECRET=
# [FIXED VALUE]
FIBER_NODE_URL=http://fiber-node:8227
# [OPTIONAL] Biscuit token — not required by default (fiber-node has no
# public IP).
FIBER_NODE_RPC_AUTH_TOKEN=
# [REQUIRED] AES-256-GCM key encrypting webhook_endpoints.secret at rest —
# 64-char hex string. create-fibergate generates this for you; if
# hand-fixing, use openssl rand -hex 32.
WEBHOOK_SECRET_ENCRYPTION_KEY=
# [OPTIONAL] Protects /api/cron/poll-invoices (manual trigger)
CRON_SECRET=

# ---- Published image (issues #21 + #41) ----
# [REQUIRED] GitHub org/user the fibergate-core image was published under
# (see https://github.com/<owner>/<repo>/pkgs/container/fibergate-core),
# e.g. tiennt0212.
GHCR_NAMESPACE=
# [OPTIONAL] Pin to a specific build (e.g. sha-a1b2c3d) instead of the
# latest canary build. Defaults to "latest" if unset.
FIBERGATE_CORE_TAG=
