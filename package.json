{
  "name": "fibergate",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "docker:dev": "docker compose up -d postgres fiber-node",
    "docker:dev:down": "docker compose stop postgres fiber-node fiber-node-preflight",
    "docker:payer": "docker compose up -d fiber-node-payer",
    "docker:payer:down": "docker compose stop fiber-node-payer fiber-node-payer-preflight",
    "generate:env": "pnpm --filter create-fibergate build && node packages/create-fibergate/dist/generate-local-env.js",
    "create-fibergate:dev": "pnpm --filter create-fibergate dev"
  }
}
