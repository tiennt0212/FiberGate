{
  "name": "@fibergate/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for FiberGate — create invoices and verify webhooks from your app",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(sdk) no lint configured\""
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
