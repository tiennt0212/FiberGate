{
  "name": "create-fibergate",
  "version": "0.1.2",
  "description": "Scaffold a FiberGate merchant deploy directory (.env, CKB key, docker-compose.release.yml) with one interactive command.",
  "keywords": [
    "fibergate",
    "fiber-network",
    "ckb",
    "payment-gateway",
    "scaffolding",
    "cli"
  ],
  "license": "MIT",
  "author": "tiennt0212",
  "homepage": "https://github.com/tiennt0212/FiberGate/tree/canary/packages/create-fibergate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiennt0212/FiberGate.git",
    "directory": "packages/create-fibergate"
  },
  "bugs": "https://github.com/tiennt0212/FiberGate/issues",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "create-fibergate": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-templates.mjs",
    "build": "pnpm run prebuild && tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
