# Root .env for `docker compose up -d` (docker-compose.yml reads this file
# automatically). Copy to .env and fill in real values — never commit .env.
# Full description of each var: .context/architecture/system-design.md#environment-variables
# How to generate each required secret: README.md "Generating secrets"

# ---- postgres container init — single source of truth for DB credentials ----

# [CONFIGURABLE] Pick your own values or keep the defaults below — both the
# postgres service and fibergate-core read these same 3 vars, so they always
# stay in sync with each other.
POSTGRES_USER=fibergate
POSTGRES_DB=fibergate
# [REQUIRED]
POSTGRES_PASSWORD=

# ---- fiber-node's own secret (NOT one of FiberGate's app vars below — only
# fiber-node reads this, to unlock the CKB signing key at
# docker/fiber-node/ckb/key. Kept here anyway, in its own section, so a plain
# `cp .env.example .env` surfaces every required value in one pass) ----

# [REQUIRED] Password protecting the CKB testnet key file. Must match the
# passphrase used when that key was encrypted, not a freely-chosen secret. See
# README.md "Running the full stack" step 2 for how to provide the key file.
FIBER_SECRET_KEY_PASSWORD=

# ---- nginx + certbot (public HTTPS entry point) — see
# docs/merchants/public-https-deploy.md for the full runbook. Required for a
# plain `docker compose up -d` to work at all: nginx is now the only service
# that publishes public host ports (80/443/8228), fronting fibergate-core's
# dashboard/API and fiber-node's P2P port over WSS. ----

# [REQUIRED] Public domain for this deploy — must have a DNS A/AAAA record
# pointing at this host's public IP, with ports 80/443/8228 reachable from
# the internet (firewall/router port-forwarding). No default: nginx won't
# start a usable config without a real value here. It is also the single source
# for the address fiber-node announces to the Fiber network (the compose file
# builds both the plain-TCP and /wss multiaddrs from it) — leave it blank and
# the network bans this node, so no payment can ever reach it.
DOMAIN=

# [OPTIONAL] The public hostname other Fiber nodes should use to reach this
# node. Blank is correct for normal local development, and means this node
# announces no address at all — deliberate: DOMAIN here is usually "localhost",
# and announcing that would tell the public testnet to reach you at an address
# that resolves to *their* machine, littering the shared network graph from
# every developer's laptop.
#
# Set it only if you actually want this node reachable from outside — then it
# must be a real, publicly-resolvable hostname pointing at this machine, with
# port 8228 open. (In a merchant deploy this variable means something narrower:
# it's the escape hatch for a DOMAIN behind a CDN proxy, and defaults to DOMAIN
# rather than to blank. See .env.release.example.)
FIBER_P2P_DOMAIN=

# [OPTIONAL] Email for Let's Encrypt certificate expiry notices. Not read by
# `docker compose up -d` at all (nginx-certs-preflight generates a temporary
# self-signed cert regardless of this value) — only needed for the one-time
# `docker compose run --rm certbot-init` in
# docs/merchants/public-https-deploy.md step 3, when you're ready to get a
# real trusted cert. Safe to leave blank until then.
CERTBOT_EMAIL=

# ---- FiberGate app vars (apps/web / fibergate-core) ----

# [REQUIRED] Base64-encoded bcrypt hash, used for dashboard single-admin
# login — base64, NOT the raw "$2y$10$..." hash. See README.md "Generating
# secrets" for why (raw hashes contain "$", which Docker Compose's .env
# interpolation and dotenv-expand each corrupt differently).
ADMIN_PASSWORD_HASH_B64=

# [REQUIRED] Signs the dashboard session cookie (httpOnly JWT). Dedicated to
# this purpose — must be distinct from FIBERGATE_INTERNAL_SECRET (BR-SEC-004).
DASHBOARD_SESSION_SECRET=

# [REQUIRED] Shared secret — the storefront app uses this to call /api/v1/*
FIBERGATE_INTERNAL_SECRET=

# [FIXED VALUE] Do not change unless you also change
# docker/fiber-node/config.yml's rpc.listening_addr. "fiber-node" is the
# docker-compose service's DNS name, only resolvable inside the internal network.
FIBER_NODE_URL=http://fiber-node:8227

# [OPTIONAL] Biscuit token — fiber-node has no public IP so this isn't required
# (see system-design.md if you enable it)
FIBER_NODE_RPC_AUTH_TOKEN=

# [REQUIRED] AES-256-GCM key encrypting webhook_endpoints.secret at rest —
# 64-character hex string (32 bytes), NOT a signing key itself. Each webhook
# endpoint gets its own random >=32-byte secret (BR-SEC-003) that actually
# signs that endpoint's payloads (BR-WHK-004); this var only protects that
# per-endpoint secret at rest. create-fibergate generates this for you; if
# hand-fixing, it's a 64-char hex string (openssl rand -hex 32).
WEBHOOK_SECRET_ENCRYPTION_KEY=

# [OPTIONAL] Protects /api/cron/poll-invoices (manual trigger)
CRON_SECRET=

# ---- fiber-node-payer — local-testing-only, gated behind `docker compose up
# -d fiber-node-payer` / `pnpm docker:payer` (profiles: [payer], never starts
# via a bare `docker compose up -d`). Only needed if you're paying demo
# invoices with a second local node — see README.md "Pay a demo invoice with
# a second local node (fiber-node-payer)". ----

# [REQUIRED only for fiber-node-payer] Password protecting the CKB testnet
# key at docker/fiber-node-payer/ckb/key — a SEPARATE key/passphrase from
# FIBER_SECRET_KEY_PASSWORD above (that one belongs to fiber-node, the
# merchant's node; this one belongs to fiber-node-payer, a throwaway test
# wallet).
FIBER_PAYER_SECRET_KEY_PASSWORD=
