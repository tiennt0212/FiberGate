# ─────────────────────────────────────────────────────────────
# FiberGate — environment variables
# Copy to .env and fill in before `docker compose up -d`
# NEVER commit the filled-in .env (see .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Inside docker-compose the host is the `postgres` service name.
DATABASE_URL=postgres://fibergate:fibergate@postgres:5432/fibergate
POSTGRES_USER=fibergate
POSTGRES_PASSWORD=fibergate
POSTGRES_DB=fibergate

# ── Dashboard single-admin gate ───────────────────────────────
# bcrypt hash of your admin password (BR-SEC-002). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
ADMIN_PASSWORD_HASH=
# Secret used to sign the dashboard session cookie (BR-SEC-004).
# Must differ from FIBERGATE_INTERNAL_SECRET. Min 32 bytes recommended.
SESSION_SECRET=

# ── Internal API auth ─────────────────────────────────────────
# Shared bearer secret the storefront app uses to call /api/v1/* (BR-SEC-001).
# Single value, constant-time compared, never logged.
FIBERGATE_INTERNAL_SECRET=

# ── Fiber node (FNN) ──────────────────────────────────────────
# Inside docker-compose the host is the `fiber-node` service name.
FIBER_NODE_URL=http://fiber-node:8227
# Optional Biscuit token. Leave empty when the node only binds internally.
FIBER_NODE_SECRET=

# ── Cron endpoint (optional manual poll trigger) ──────────────
CRON_SECRET=

# ── Poller ────────────────────────────────────────────────────
# Interval (ms) for the in-process invoice poller (BR-POL-001, default 10s).
POLL_INTERVAL_MS=10000
# Set to "false" to disable the in-process poller (e.g. when polling externally).
POLLER_ENABLED=true
